# Repository policy lives only in these two root files.
**/.gitignore
**/.gitattributes
!/.gitignore
!/.gitattributes
.git/

# Local distribution, maintenance workspace and generated package catalog.
/dist/
/local/
/workspace-tools/
/package-manifest.json

# Tools, tests and generated artifacts at any depth stay local.
tools/
tests/
__tests__/
test_*
test-*
*_test.*
*.test.*
*.spec.*
dist/
releases/
local/
offline/
artifacts/
screenshots/
output/
coverage/
htmlcov/
.coverage
.coverage.*

# Dependencies, build output and caches.
node_modules/
.tools/
.deps/
.build/
build/
target/
.venv/
venv/
.cache/
.test-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/

# Downloaded runtime engines; installed from verified upstream packages.
/*/src/files/mihomo
/downloadcenter/src/files/aria2c
/downloadcenter/src/files/qbittorrent-nox

# Archives, temporary files and runtime state.
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.log
*.tmp
*.temp
*.pid
*.sock
*.swp
*.swo
*~
**/etc/var/

# Real credentials and local environment files.
.env
.env.*
!.env.example
*.key
*.pem
*.pub
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Operating-system metadata.
.DS_Store
Thumbs.db
desktop.ini
